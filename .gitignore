# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but track .env.example so contributors can see the required vars
!.env.example

# vercel
.vercel

# supabase CLI working directory (created by `supabase link` / `db pull` /
# `migration new`). Never contains the project ref or our schema —
# safe to ignore. The committed source-of-truth is supabase/migrations/
# and supabase/config.toml.
.supabase/
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
